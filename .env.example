# =========================================
# SoleStream configuration template
#
# Copy this file to .env and adjust:
#
#   Copy-Item .env.example .env     (PowerShell)
#   cp .env.example .env            (bash)
#
# .env is gitignored; this template is
# committed.
# =========================================


# -----------------------------------------
# Kafka broker address
#
# This file is read by processes running ON
# THE HOST (app.py, and consumer.py when you
# run it by hand), so the value here is the
# host-facing listener published by
# docker-compose.
#
# The containerised producer and consumer do
# NOT use this value. docker-compose sets
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092 for
# them directly, because inside the compose
# network that is the address that resolves.
# -----------------------------------------

KAFKA_BOOTSTRAP_SERVERS=localhost:29092


# -----------------------------------------
# Topic name
#
# Unlike the broker address, this is the same
# from every vantage point, so docker-compose
# substitutes it into the container services
# from this same file.
# -----------------------------------------

KAFKA_TOPIC=clickstream-json


# -----------------------------------------
# Dead-letter topic
#
# consumer.py routes events that are missing
# a required field (docs/tracking-plan.md)
# here instead of processing them. Same
# everywhere, like the topic above.
# -----------------------------------------

KAFKA_DLQ_TOPIC=clickstream-json-dlq
