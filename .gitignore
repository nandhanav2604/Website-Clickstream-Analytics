# --------------------------------
# Local configuration
#
# .env holds machine-specific values
# and is never committed.
# .env.example is the committed
# template and is NOT matched by the
# ".env" pattern below, because the
# pattern matches that exact filename
# only.
# --------------------------------

.env
config.bat

