FROM python:3.11-slim

# Send print() straight to the container log instead of sitting in an
# 8KB block buffer. Without this the startup config banner does not
# show up in "docker compose logs" until long after startup.
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt requirements-sink.txt ./

RUN pip install --no-cache-dir -r requirements-sink.txt

COPY config.py sink.py ./

# Exec form, so python is PID 1 and receives SIGTERM from
# "docker compose down" directly - sink.py flushes on it.
CMD ["python", "sink.py"]
